      "source": [
        "# Retrieve transformed feature names from the fitted Ridge preprocessor.\n",
        "transformed_feature_names = (\n",
        "    best_ridge_model\n",
        "    .named_steps[\"preprocessor\"]\n",
        "    .get_feature_names_out()\n",
        ")\n",
        "\n",
        "# Retrieve the fitted regularized coefficients.\n",
        "ridge_coefficients = (\n",
        "    best_ridge_model\n",
        "    .named_steps[\"model\"]\n",
        "    .coef_\n",
        ")\n",
        "\n",
        "lasso_coefficients = (\n",
        "    best_lasso_model\n",
        "    .named_steps[\"model\"]\n",
        "    .coef_\n",
        ")\n",
        "\n",
        "coefficient_comparison = pd.DataFrame({\n",
        "    \"Transformed_Feature\": transformed_feature_names,\n",
        "    \"Ridge_Coefficient\": ridge_coefficients,\n",
        "    \"Lasso_Coefficient\": lasso_coefficients\n",
        "})\n",
        "\n",
        "coefficient_comparison[\"Ridge_Absolute\"] = (\n",
        "    coefficient_comparison[\"Ridge_Coefficient\"].abs()\n",
        ")\n",
        "\n",
        "coefficient_comparison[\"Lasso_Absolute\"] = (\n",
        "    coefficient_comparison[\"Lasso_Coefficient\"].abs()\n",
        ")\n",
        "\n",
        "coefficient_comparison = (\n",
        "    coefficient_comparison\n",
        "    .sort_values(\n",
        "        \"Ridge_Absolute\",\n",
        "        ascending=False\n",
        "    )\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"--- Standardized Ridge vs. Lasso Coefficients ---\")\n",
        "display(coefficient_comparison)\n",
        "\n",
        "number_lasso_zero = np.sum(\n",
