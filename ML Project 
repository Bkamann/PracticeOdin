      "source": [
        "Step 8: Found that a handful of square-footage columns were basically duplicates of each other (like two ways of measuring the same thing), which confuses a regression model. Dropped six of those overlapping columns to clean things up."
      ],
      "metadata": {
        "id": "50BCewUsRvhp"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Remove redundant data. Floor SQft is equal to total Sqft causing the inf in VIF\n",
        "redundant_components = [\n",
        "    \"1st Flr SF\",\n",
        "    \"2nd Flr SF\",\n",
        "    \"Low Qual Fin SF\",\n",
        "    \"BsmtFin SF 1\",\n",
        "    \"BsmtFin SF 2\",\n",
        "    \"Bsmt Unf SF\"\n",
        "]\n",
        "\n",
        "# Remove from the numeric feature list used by the preprocessor.\n",
        "numeric_features = [col for col in numeric_features if col not in redundant_components]\n",
        "\n",
        "# Remove from the overall selected-features list too, so it stays in sync.\n",
        "SELECTED_FEATURES = [col for col in SELECTED_FEATURES if col not in redundant_components]\n",
        "\n",
        "# Drop from the actual train/test feature sets.\n",
        "X_train = X_train.drop(columns=redundant_components)\n",
        "X_test = X_test.drop(columns=redundant_components)\n",
        "\n",
        "print(f\"Dropped {len(redundant_components)} redundant columns: {redundant_components}\")\n",
        "print(\"Remaining numeric features:\", len(numeric_features))\n",
        "print(\"X_train shape:\", X_train.shape)\n",
        "print(\"X_test shape:\", X_test.shape)"
      ],
