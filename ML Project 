      "source": [
        "Step 20: build an ensemble preprocessing and tune with CV. I had to change the one-hot encoding due to run time. I had too many categorical columns and the tree pre-processor was taking entirely too long."
      ],
      "metadata": {
        "id": "dIb72Fw_U44E"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.ensemble import RandomForestRegressor, HistGradientBoostingRegressor\n",
        "from sklearn.model_selection import RandomizedSearchCV\n",
        "from sklearn.preprocessing import OneHotEncoder\n",
        "\n",
        "def build_tree_preprocessor():\n",
        "    numeric_pipe = Pipeline([\n",
        "        (\"imputer\", SimpleImputer(strategy=\"median\"))\n",
        "    ])\n",
        "    categorical_pipe = Pipeline([\n",
        "        (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
        "        (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))\n",
        "    ])\n",
        "    return ColumnTransformer(\n",
        "        transformers=[\n",
        "            (\"num\", numeric_pipe, numeric_features),\n",
        "            (\"cat\", categorical_pipe, categorical_features)\n",
        "        ],\n",
        "        remainder=\"drop\"\n",
        "    )\n",
        "\n",
        "def build_tree_model(estimator):\n",
        "    return Pipeline([\n",
        "        (\"preprocessor\", build_tree_preprocessor()),\n",
        "        (\"model\", estimator)\n",
        "    ])\n",
        "\n",
        "# --- Random Forest (lighter) ---\n",
        "rf_param_dist = {\n",
        "    \"model__n_estimators\": [200, 300],\n",
        "    \"model__max_depth\": [15, 25],\n",
        "    \"model__min_samples_leaf\": [1, 2, 4],\n",
        "    \"model__max_features\": [\"sqrt\", 0.33]\n",
        "}\n",
        "\n",
        "rf_search = RandomizedSearchCV(\n",
        "    estimator=build_tree_model(RandomForestRegressor(random_state=RANDOM_STATE)),\n",
        "    param_distributions=rf_param_dist,\n",
        "    n_iter=10,\n",
        "    scoring=\"neg_root_mean_squared_error\",\n",
        "    cv=CV,\n",
        "    n_jobs=-1,\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "print(\"Tuning Random Forest...\")\n",
        "rf_search.fit(X_train, y_train)\n",
        "print(\"Best RF params:\", rf_search.best_params_)\n",
        "print(\"Best RF CV RMSE:\", -rf_search.best_score_)\n",
        "\n",
        "# --- Gradient Boosting (histogram-based, much faster) ---\n",
        "gb_param_dist = {\n",
        "    \"model__max_iter\": [300, 500],\n",
        "    \"model__learning_rate\": [0.03, 0.05, 0.1],\n",
        "    \"model__max_depth\": [3, 5, None],\n",
        "    \"model__min_samples_leaf\": [10, 20, 30],\n",
        "    \"model__l2_regularization\": [0.0, 1.0, 10.0]\n",
        "}\n",
        "\n",
        "gb_search = RandomizedSearchCV(\n",
        "    estimator=build_tree_model(HistGradientBoostingRegressor(random_state=RANDOM_STATE)),\n",
        "    param_distributions=gb_param_dist,\n",
        "    n_iter=15,\n",
        "    scoring=\"neg_root_mean_squared_error\",\n",
        "    cv=CV,\n",
        "    n_jobs=-1,\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "print(\"\\nTuning Gradient Boosting...\")\n",
        "gb_search.fit(X_train, y_train)\n",
        "print(\"Best GB params:\", gb_search.best_params_)\n",
        "print(\"Best GB CV RMSE:\", -gb_search.best_score_)"
      ],
