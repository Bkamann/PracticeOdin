      "source": [
        "# Create a conditional pricing grid.\n",
        "# Year Built varies while all other predictors are held at training medians.\n",
        "# For my features, I had to ignore the non numerical features\n",
        "\n",
        "plot_feature_range = np.linspace(\n",
        "    X_train[SPLINE_FEATURE].min(),\n",
        "    X_train[SPLINE_FEATURE].max(),\n",
        "    250\n",
        ")\n",
        "\n",
        "training_medians = {\n",
        "    column: X_train[column].median()\n",
        "    for column in numeric_features\n",
        "}\n",
        "\n",
        "X_curve = pd.DataFrame(\n",
        "    [training_medians] * len(plot_feature_range),\n",
        "    columns=numeric_features\n",
        ")\n",
        "\n",
        "X_curve[SPLINE_FEATURE] = plot_feature_range\n",
        "\n",
        "\n",
        "# Select an integration function compatible with multiple NumPy versions.\n",
        "integration_function = getattr(\n",
        "    np,\n",
        "    \"trapezoid\",\n",
        "    np.trapz\n",
        ")\n",
        "\n",
        "\n",
        "def calculate_curve_roughness(x_values, y_values):\n",
        "    '''\n",
        "    Numerically approximate:\n",
        "\n",
        "        Integral [f''(x)]^2 dx\n",
        "\n",
        "    Larger values indicate a more curved/wiggly pricing function.\n",
        "    '''\n",
        "\n",
        "    first_derivative = np.gradient(\n",
        "        y_values,\n",
        "        x_values\n",
        "    )\n",
        "\n",
        "    second_derivative = np.gradient(\n",
        "        first_derivative,\n",
        "        x_values\n",
        "    )\n",
        "\n",
        "    squared_curvature = (\n",
        "        second_derivative ** 2\n",
        "    )\n",
        "\n",
        "    return float(\n",
        "        integration_function(\n",
        "            squared_curvature,\n",
        "            x_values\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "# Evaluate Ridge and Lasso candidates across their alpha grids.\n",
        "smoothness_records = []\n",
        "\n",
        "candidate_families = {\n",
        "    \"Ridge Regression\": RIDGE_ALPHAS,\n",
        "    \"Lasso Regression\": LASSO_ALPHAS\n",
        "}\n",
        "\n",
        "for model_family, alpha_values in candidate_families.items():\n",
        "\n",
        "    for alpha in alpha_values:\n",
        "\n",
        "        if model_family == \"Ridge Regression\":\n",
        "            candidate_model = build_spline_model(\n",
        "                Ridge(alpha=alpha)\n",
        "            )\n",
        "\n",
        "        else:\n",
        "            candidate_model = build_spline_model(\n",
        "                Lasso(\n",
        "                    alpha=alpha,\n",
        "                    max_iter=100_000\n",
        "                )\n",
        "            )\n",
        "\n",
        "        # Estimate predictive error using training-data cross-validation only.\n",
        "        cv_scores = -cross_val_score(\n",
        "            candidate_model,\n",
        "            X_train,\n",
        "            y_train,\n",
        "            scoring=\"neg_root_mean_squared_error\",\n",
        "            cv=CV,\n",
        "            n_jobs=-1\n",
        "        )\n",
        "\n",
        "        mean_cv_rmse = cv_scores.mean()\n",
        "\n",
        "        # Fit to the full training set so the conditional pricing curve can be measured.\n",
        "        candidate_model.fit(\n",
        "            X_train,\n",
        "            y_train\n",
        "        )\n",
        "\n",
        "        candidate_curve = candidate_model.predict(\n",
        "            X_curve\n",
        "        )\n",
        "\n",
        "        roughness = calculate_curve_roughness(\n",
        "            plot_feature_range,\n",
        "            candidate_curve\n",
        "        )\n",
        "\n",
        "        smoothness_records.append({\n",
        "            \"Model\": model_family,\n",
        "            \"Alpha\": alpha,\n",
        "            \"CV_RMSE\": mean_cv_rmse,\n",
        "            \"Curve_Roughness\": roughness\n",
        "        })\n",
        "\n",
        "\n",
        "smoothness_table = pd.DataFrame(\n",
        "    smoothness_records\n",
        ")\n",
        "\n",
        "\n",
        "# Normalize CV error and roughness to a common 0-1 scale.\n",
        "for column in [\n",
        "    \"CV_RMSE\",\n",
        "    \"Curve_Roughness\"\n",
        "]:\n",
        "\n",
        "    minimum = smoothness_table[column].min()\n",
        "    maximum = smoothness_table[column].max()\n",
        "\n",
        "    if maximum > minimum:\n",
        "        smoothness_table[\n",
        "            f\"{column}_Normalized\"\n",
        "        ] = (\n",
        "            smoothness_table[column] - minimum\n",
        "        ) / (\n",
        "            maximum - minimum\n",
        "        )\n",
        "    else:\n",
        "        smoothness_table[\n",
        "            f\"{column}_Normalized\"\n",
        "        ] = 0.0\n",
        "\n",
        "\n",
        "# Explicit smoothness weight.\n",
        "# Predictive fit receives the greater emphasis.\n",
        "SMOOTHNESS_WEIGHT = 0.15\n",
        "\n",
        "smoothness_table[\"Selection_Objective\"] = (\n",
        "    smoothness_table[\"CV_RMSE_Normalized\"]\n",
        "    +\n",
        "    SMOOTHNESS_WEIGHT\n",
        "    * smoothness_table[\"Curve_Roughness_Normalized\"]\n",
        ")\n",
        "\n",
        "smoothness_table = (\n",
        "    smoothness_table\n",
        "    .sort_values(\"Selection_Objective\")\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"--- Best Fit–Smoothness Candidates ---\")\n",
        "display(\n",
        "    smoothness_table.head(10)\n",
        ")"
      ]
