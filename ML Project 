    {
      "cell_type": "markdown",
      "source": [
        "Step 9: Most features get treated as a straight-line relationship with price, but \"Year Built\" was allowed to bend using something called a spline. Letting the model draw a smooth curve instead of a rigid line, since older vs. newer homes probably don't gain value in a perfectly even way."
      ],
      "metadata": {
        "id": "qwecX7HBSGbX"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Define the feature modeled with splines.\n",
        "SPLINE_FEATURE = \"Year Built\"\n",
        "\n",
        "# The remaining numeric predictors enter as linear terms.\n",
        "LINEAR_FEATURES = [\n",
        "    feature\n",
        "    for feature in numeric_features\n",
        "    if feature != SPLINE_FEATURE\n",
        "]\n",
        "\n",
        "# Cubic spline.\n",
        "SPLINE_DEGREE = 3\n",
        "\n",
        "# Explicit knots must be 2D:\n",
        "# shape = (number_of_knots, number_of_spline_features).\n",
        "# Check X_train[\"Year Built\"].describe() and adjust these to your actual range.\n",
        "SPLINE_KNOTS = np.array([\n",
        "    [1930.0],\n",
        "    [1960.0],\n",
        "    [1980.0],\n",
        "    [1995.0],\n",
        "    [2005.0]\n",
        "])\n",
        "\n",
        "\n",
        "def build_preprocessor():\n",
        "    '''\n",
        "    Create a fresh preprocessing object for each model.\n",
        "\n",
        "    LINEAR FEATURES:\n",
        "        median imputation -> passthrough\n",
        "\n",
        "    YEAR BUILT:\n",
        "        median imputation -> cubic spline transformation\n",
        "    '''\n",
        "\n",
        "    linear_pipeline = Pipeline([\n",
        "        (\"imputer\", SimpleImputer(strategy=\"median\"))\n",
        "    ])\n",
        "\n",
        "    spline_pipeline = Pipeline([\n",
        "        (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "        (\"spline\", SplineTransformer(\n",
        "            degree=SPLINE_DEGREE,\n",
        "            knots=SPLINE_KNOTS,\n",
        "            include_bias=False\n",
        "        ))\n",
        "    ])\n",
        "\n",
        "    return ColumnTransformer(\n",
        "        transformers=[\n",
        "            (\"linear\", linear_pipeline, LINEAR_FEATURES),\n",
        "            (\"year_built_spline\", spline_pipeline, [SPLINE_FEATURE])\n",
        "        ],\n",
        "        remainder=\"drop\",\n",
        "        verbose_feature_names_out=False\n",
        "    )\n",
        "\n",
        "\n",
        "def build_spline_model(estimator):\n",
        "    '''\n",
        "    Complete model pipeline:\n",
        "\n",
        "        raw X\n",
        "          -> imputation / spline feature engineering\n",
        "          -> standardization\n",
        "          -> regression estimator\n",
        "    '''\n",
        "\n",
        "    return Pipeline([\n",
        "        (\"preprocessor\", build_preprocessor()),\n",
        "        (\"scaler\", StandardScaler()),\n",
        "        (\"model\", estimator)\n",
        "    ])\n",
        "\n",
        "\n",
        "print(\"Linear features:\", LINEAR_FEATURES)\n",
        "print(\"Spline feature:\", SPLINE_FEATURE)\n",
        "print(\"Spline knots:\", SPLINE_KNOTS.ravel())"
      ],
