      "source": [
        "# Multicollinearity diagnostics: correlation matrix and VIF.\n",
        "# I can only run this on numeric predictors — VIF and .corr() require numeric input\n",
        "\n",
        "# Make a temporary copy of the numeric features only, for diagnostics.\n",
        "# This copy is never used for the actual model — it exists purely to check\n",
        "# for multicollinearity before deciding on Ridge vs. Lasso vs. plain regression.\n",
        "X_train_diagnostic = X_train[numeric_features].copy()\n",
        "\n",
        "# Fill missing numeric values with the median for this diagnostic only.\n",
        "# VIF requires a complete numeric matrix with no NaNs to run linear regression.\n",
        "for column in X_train_diagnostic.columns:\n",
        "    X_train_diagnostic[column] = X_train_diagnostic[column].fillna(\n",
        "        X_train_diagnostic[column].median()\n",
        "    )\n",
        "\n",
        "# Calculate pairwise correlation between every numeric predictor.\n",
        "# Values close to +1 or -1 mean two features move together almost identically.\n",
        "correlation_matrix = X_train_diagnostic.corr()\n",
        "\n",
        "print(\"--- Training Predictor Correlations (Numeric Features) ---\")\n",
        "display(correlation_matrix.round(3))\n",
        "\n",
        "# Visualize the correlation matrix as a heatmap.\n",
        "# Easier to spot problem pairs visually than by scanning a large numeric table.\n",
        "plt.figure(figsize=(14, 12))\n",
        "correlation_image = plt.imshow(\n",
        "    correlation_matrix,\n",
        "    aspect=\"auto\"\n",
        ")\n",
        "plt.colorbar(\n",
        "    correlation_image,\n",
        "    label=\"Correlation\"\n",
        ")\n",
        "plt.xticks(\n",
        "    range(len(correlation_matrix.columns)),\n",
        "    correlation_matrix.columns,\n",
        "    rotation=45,\n",
        "    ha=\"right\"\n",
        ")\n",
        "plt.yticks(\n",
        "    range(len(correlation_matrix.columns)),\n",
        "    correlation_matrix.columns\n",
        ")\n",
        "plt.title(\"Training Predictor Correlation Matrix (Ames Numeric Features)\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "def calculate_vif(predictor_df):\n",
        "    '''\n",
        "    Calculate Variance Inflation Factor (VIF) for each numeric predictor.\n",
        "\n",
        "    VIF measures how much a feature can be predicted from the OTHER features.\n",
        "    For each feature:\n",
        "        1. Treat it as the target and every other feature as predictors.\n",
        "        2. Fit a linear regression and get R-squared.\n",
        "        3. VIF = 1 / (1 - R^2).\n",
        "\n",
        "    A high R^2 here means this feature is redundant with the others —\n",
        "    which means a high VIF, which means multicollinearity.\n",
        "    '''\n",
        "    vif_rows = []\n",
        "\n",
        "    for feature in predictor_df.columns:\n",
        "        # Set the current feature as the \"target\" for this check.\n",
        "        temporary_y = predictor_df[feature]\n",
        "        # Every other feature becomes the predictor set.\n",
        "        temporary_X = predictor_df.drop(columns=feature)\n",
        "\n",
        "        # Fit a plain linear regression to see how well the other\n",
        "        # features can reconstruct this one.\n",
        "        vif_model = LinearRegression()\n",
        "        vif_model.fit(temporary_X, temporary_y)\n",
        "\n",
        "        r_squared = vif_model.score(\n",
        "            temporary_X,\n",
        "            temporary_y\n",
        "        )\n",
        "\n",
        "        # If R^2 is essentially 1.0, this feature is a near-exact\n",
        "        # linear combination of the others — flag it as infinite VIF\n",
        "        # rather than dividing by (nearly) zero.\n",
        "        if r_squared >= 0.999999:\n",
        "            vif = np.inf\n",
        "        else:\n",
        "            vif = 1.0 / (1.0 - r_squared)\n",
        "\n",
        "        vif_rows.append({\n",
        "            \"Feature\": feature,\n",
        "            \"R2_explained_by_other_predictors\": r_squared,\n",
        "            \"VIF\": vif\n",
        "        })\n",
        "\n",
        "    # Sort worst offenders (highest VIF) to the top for easy reporting.\n",
        "    return (\n",
        "        pd.DataFrame(vif_rows)\n",
        "        .sort_values(\"VIF\", ascending=False)\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "\n",
        "# Run the VIF calculation on the diagnostic dataset.\n",
        "vif_table = calculate_vif(X_train_diagnostic)\n",
        "\n",
        "print(\"\\n--- Variance Inflation Factors ---\")\n",
        "display(vif_table)"
