    {
      "cell_type": "code",
      "source": [
        "def evaluate_model(model_name, fitted_model, X_evaluate, y_evaluate):\n",
        "    '''\n",
        "    Calculate MAE, RMSE, and R-squared for a fitted regression model.\n",
        "    '''\n",
        "\n",
        "    predictions = fitted_model.predict(\n",
        "        X_evaluate\n",
        "    )\n",
        "\n",
        "    mae = mean_absolute_error(\n",
        "        y_evaluate,\n",
        "        predictions\n",
        "    )\n",
        "\n",
        "    rmse = np.sqrt(\n",
        "        mean_squared_error(\n",
        "            y_evaluate,\n",
        "            predictions\n",
        "        )\n",
        "    )\n",
        "\n",
        "    r2 = r2_score(\n",
        "        y_evaluate,\n",
        "        predictions\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"Model\": model_name,\n",
        "        \"MAE\": mae,\n",
        "        \"RMSE\": rmse,\n",
        "        \"R2\": r2\n",
        "    }\n",
        "\n",
        "\n",
        "# The baseline and tuned Ridge/Lasso objects have already been fitted on X_train.\n",
        "# Evaluate them now only for final reporting.\n",
        "final_results = [\n",
        "    evaluate_model(\n",
        "        \"Unregularized Spline Regression\",\n",
        "        pipeline_lr,\n",
        "        X_test,\n",
        "        y_test\n",
        "    ),\n",
        "    evaluate_model(\n",
        "        f\"Tuned Ridge (alpha={best_ridge_alpha:.4g})\",\n",
        "        best_ridge_model,\n",
        "        X_test,\n",
        "        y_test\n",
        "    ),\n",
        "    evaluate_model(\n",
        "        f\"Tuned Lasso (alpha={best_lasso_alpha:.4g})\",\n",
        "        best_lasso_model,\n",
        "        X_test,\n",
        "        y_test\n",
        "    ),\n",
        "    evaluate_model(\n",
        "        f\"Final Smoothness-Aware {chosen_model_name} (alpha={chosen_alpha:.4g})\",\n",
        "        chosen_model,\n",
        "        X_test,\n",
        "        y_test\n",
        "    )\n",
        "]\n",
        "\n",
        "results_df = (\n",
