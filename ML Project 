        "# Calculate permutation importance on the held-out test set.\n",
        "permutation_result = permutation_importance(\n",
        "    estimator=chosen_model,\n",
        "    X=X_test,\n",
        "    y=y_test,\n",
        "    scoring=\"r2\",\n",
        "    n_repeats=30,\n",
        "    random_state=RANDOM_STATE,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "# Create the feature-importance table using original input features.\n",
        "feature_importance_df = pd.DataFrame({\n",
        "    \"Feature\": X_test.columns,\n",
        "    \"Mean_Permutation_Importance\": permutation_result.importances_mean,\n",
        "    \"Importance_Std\": permutation_result.importances_std\n",
        "})\n",
        "\n",
        "# Clip negative values only when constructing the percentage-style index.\n",
        "positive_importance = np.clip(\n",
        "    feature_importance_df[\n",
        "        \"Mean_Permutation_Importance\"\n",
        "    ].to_numpy(),\n",
        "    0,\n",
        "    None\n",
        ")\n",
        "\n",
        "if positive_importance.sum() > 0:\n",
        "    feature_importance_df[\n",
        "        \"Feature_Importance_Index\"\n",
        "    ] = (\n",
        "        100\n",
        "        * positive_importance\n",
        "        / positive_importance.sum()\n",
        "    )\n",
        "else:\n",
        "    feature_importance_df[\n",
        "        \"Feature_Importance_Index\"\n",
        "    ] = 0.0\n",
        "\n",
